+from __future__ import annotations
+
+import re
+from typing import Any
+
+from .stocks import analyze_stock
+
+
+STOCK_SKILLS: list[dict[str, Any]] = [
+    {
+        "id": "single_stock_diagnosis",
+        "name": "个股诊断",
