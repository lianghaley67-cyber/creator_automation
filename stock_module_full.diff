+def _build_report(
+    quote: dict[str, Any],
+    indicators: dict[str, Any],
+    score: int,
+    stance: str,
+    risks: list[str],
+    opportunities: list[str],
+    *,
+    question: str,
+) -> str:
+    lines = [
+        f"## {quote.get('name')}（{quote.get('symbol')}）AI 辅助分析",
