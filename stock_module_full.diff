+        "inputs": ["symbol", "question"],
+    },
+    {
+        "id": "watchlist_review",
+        "name": "自选股复盘",
+        "description": "结合自选股行情、成本、仓位和预警线，输出今天最该关注的标的。",
+        "inputs": ["watchlist"],
+    },
+    {
+        "id": "condition_screening",
+        "name": "条件选股",
+        "description": "在已有自选股内按自然语言条件筛选，例如强趋势、超卖、低波动、突破。",
+        "inputs": ["watchlist", "question"],
+    },
+    {
+        "id": "financial_checklist",
