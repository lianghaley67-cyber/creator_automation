+def _trend_label(latest: float | None, ma5: float | None, ma20: float | None, ma60: float | None) -> str:
+    if latest and ma5 and ma20 and ma60:
+        if latest > ma5 > ma20 > ma60:
+            return "多头排列"
+        if latest < ma5 < ma20 < ma60:
+            return "空头排列"
+        if latest > ma5 and ma5 > ma20:
+            return "短线强于中期"
+        if latest < ma5 and ma5 < ma20:
+            return "短线弱于中期"
