+        "inputs": ["symbol", "question"],
+    },
+    {
+        "id": "news_risk_scan",
+        "name": "公告新闻风险扫描",
+        "description": "基于价格异动生成公告、新闻、财报、行业政策的核验路径。",
+        "inputs": ["symbol", "question"],
+    },
+    {
+        "id": "money_flow_sentiment",
