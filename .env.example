# Copy this file to .env and fill in your own keys.
# Do not commit .env.

# Required for Zhipu script generation and Qingying/CogVideoX-3 video generation.
ZHIPUAI_API_KEY=

# Optional aliases supported by the backend.
BIGMODEL_API_KEY=
GLM_API_KEY=

# Optional script generation tuning.
SCRIPT_AI_PROVIDER=zhipu
SCRIPT_AI_MODEL=glm-4-flash
SCRIPT_AI_TEMPERATURE=0.55
SCRIPT_AI_TOP_P=0.85
SCRIPT_AI_MAX_TOKENS=700

# Optional video generation tuning.
ZHIPU_VIDEO_MODEL=cogvideox-3
ZHIPU_VIDEO_QUALITY=speed
ZHIPU_VIDEO_WATERMARK=true
ZHIPU_VIDEO_TIMEOUT_SEC=3600

# Optional TTS providers.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional Kling providers.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
DASHSCOPE_API_KEY=

# Optional public URL if an external provider needs to fetch local media.
CREATOR_STUDIO_PUBLIC_BASE_URL=

# Optional manual Douyin publish assistant URL.
DOUYIN_CREATOR_UPLOAD_URL=https://creator.douyin.com/creator-micro/content/post/video
