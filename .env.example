# Copy this file to .env and fill in your own keys.
# Do not commit .env.

# Required for Qingying/CogVideoX-3 video generation.
ZHIPUAI_API_KEY=

# Optional aliases supported by the backend.
BIGMODEL_API_KEY=
GLM_API_KEY=

# Recommended script pipeline:
# Gemini or MiniMax creates the first draft, DeepSeek reviews it,
# the same draft model revises it, then DeepSeek reviews the final copy again.
SCRIPT_AI_PROVIDER=gemini_minimax
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.1
MINIMAX_CHAT_ENDPOINT=https://api.minimax.io/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CHAT_ENDPOINT=https://api.deepseek.com/chat/completions

# Optional script generation tuning.
SCRIPT_AI_MODEL=glm-4-flash
SCRIPT_AI_TEMPERATURE=0.55
SCRIPT_AI_TOP_P=0.85
SCRIPT_AI_MAX_TOKENS=1000
# Primary style skill file injected into Gemini/MiniMax prompts.
# Windows example: C:\Users\HP\AppData\Local\hermes\skills\domain\jianghushuo-perspective\SKILL.md
# Linux/server example: /home/ubuntu/skills/jianghushuo-perspective/SKILL.md
# Leave empty to use repository skills under creator_skills/.
CREATOR_PRIMARY_SKILL_PATH=
JIANGHUSHUO_SKILL_PATH=
# Optional local markdown rules injected into Gemini/MiniMax prompts.
CREATOR_SKILLS_DIR=creator_skills
# Optional extra skill folder, recommended for local Obsidian vault rules.
# Windows example: D:\obsMD\Obsidian\vault\CreatorStudioSkills
# Linux/server example: /home/ubuntu/obsidian/CreatorStudioSkills
OBSIDIAN_SKILLS_DIR=

# Optional video generation tuning.
ZHIPU_VIDEO_MODEL=cogvideox-3
ZHIPU_VIDEO_QUALITY=speed
ZHIPU_VIDEO_WATERMARK=true
ZHIPU_VIDEO_TIMEOUT_SEC=3600

# Optional TTS providers.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional Kling providers.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
DASHSCOPE_API_KEY=

# Optional public URL if an external provider needs to fetch local media.
CREATOR_STUDIO_PUBLIC_BASE_URL=

# Optional manual Douyin publish assistant URL.
DOUYIN_CREATOR_UPLOAD_URL=https://creator.douyin.com/creator-micro/content/post/video

# Optional WeChat official account callback.
# Configure this token in the WeChat Official Account backend URL verification page.
WECHAT_CALLBACK_TOKEN=
# QR code and AppID/AppSecret must belong to the same official account.
# Changing WECHAT_APP_ID does not change the displayed QR code automatically.
# Put the current official-account QR image URL here so the web page can show it.
WECHAT_QR_IMAGE_URL=
WECHAT_ACCOUNT_NAME=你的真实公众号名称
# Optional fallback when WeChat voice callback does not include Recognition.
# AppID/AppSecret identify the account used for callbacks, media upload and drafts.
# Restart/recreate the backend container after changing either value.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Permanent image media_id used as the official-account article cover.
WECHAT_THUMB_MEDIA_ID=
WECHAT_VOICE_FALLBACK_TRANSCRIBE=true
WECHAT_VOICE_WHISPER_MODEL=small
WECHAT_NORMALIZE_SIMPLIFIED=true
# Xiaohongshu server browser automation. The login profile is persisted in studio_runtime.
# Scan the server-side QR once from the web workbench, then drafts can be saved by button.
XIAOHONGSHU_CREATOR_URL=https://creator.xiaohongshu.com/publish/publish

# Retry Edge TTS when the server network is unstable.
EDGE_TTS_RETRIES=3

# Optional: NotebookLM -> Ximalaya assisted publishing pipeline.
CREATOR_STUDIO_URL=http://43.156.8.162/
NOTEBOOKLM_URL=https://notebooklm.google.com/notebook/8a28b3eb-d0f4-44a2-a57b-3d9b437a8f37
XIMALAYA_UPLOAD_URL=https://www.ximalaya.com/anchor-center/upload
XIMALAYA_COPY_SKILL_PATH=creator_skills/jianghushuo-perspective.md
NOTEBOOKLM_AUDIO_DOWNLOAD_TIMEOUT=1800

# Optional daily AI trend collection and Obsidian/Gitee archive.
AI_TRENDS_ENABLED=true
AI_TRENDS_TIME=07:30
TAVILY_API_KEY=
GITEE_ACCESS_TOKEN=
OBSIDIAN_REPO_OWNER=lianghuanhuan
OBSIDIAN_REPO_NAME=obsidian
OBSIDIAN_ARCHIVE_DIR=01_Inbox/CreatorStudio
