# Workspace
MEDIA_FLOW_WORKSPACE=/home/ubuntu/.openclaw/workspace/media_flow
MEDIA_FLOW_MODE=notebooklm

# Tavily global trend intelligence
TAVILY_API_KEY=

# Domestic trend aggregators.
# Provide your own compliant/internal endpoints. Each endpoint should return JSON with data/items/results.
DOMESTIC_TREND_URLS=

# MiniMax draft and rewrite engine
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_CHAT_ENDPOINT=
MINIMAX_TEMPERATURE=0.78
MINIMAX_TOP_P=0.9

# DeepSeek harsh editor
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CHAT_ENDPOINT=https://api.deepseek.com/chat/completions

# Legacy bridge: replace this URL whenever your original renderer changes.
LEGACY_RENDER_URL=http://localhost:8000/api/kids/generate
LEGACY_RENDER_POLL_URL=http://localhost:8000/api/jobs/{job_id}
LEGACY_RENDER_TIMEOUT_SEC=1800
LEGACY_VIDEO_PROVIDER=zhipu_qingying

# Existing voice distillation / clone identifiers.
VOICE_ID_HUASHENG=Voice_ID_A
VOICE_ID_MAODOU=Voice_ID_B
VOICE_ID_HUMAN=My_Real_Voice_ID
USE_MY_REAL_VOICE=true

# Current Creator Studio compatibility fields.
# Keep these paths empty if the legacy renderer resolves models by voice ID.
LEGACY_HUASHENG_VOICE_REFERENCE_PATH=
LEGACY_MAODOU_VOICE_REFERENCE_PATH=

# OpenClaw WeChat Channel webhook or internal channel endpoint.
OPENCLAW_WECHAT_WEBHOOK_URL=
OPENCLAW_MESSAGE_CMD=openclaw message send --channel wechat --stdin
